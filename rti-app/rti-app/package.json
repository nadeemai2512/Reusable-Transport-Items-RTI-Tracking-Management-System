{
  "name": "rti-tracking",
  "version": "1.0.0",
  "description": "Reusable Transport Items (RTI) tracking - SAP CAP + SAPUI5",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node test/run-tests.js"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^9 || ^10",
    "@sap/xssec": "^4",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9 || ^10"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "rti",
              "roles": [
                "WarehouseOperator"
              ]
            },
            "bob": {
              "password": "rti",
              "roles": [
                "LogisticsManager"
              ]
            },
            "carol": {
              "password": "rti",
              "roles": [
                "InventoryPlanner"
              ]
            },
            "dave": {
              "password": "rti",
              "roles": [
                "LogisticsHead"
              ]
            },
            "admin": {
              "password": "rti",
              "roles": [
                "Admin",
                "LogisticsHead",
                "LogisticsManager",
                "InventoryPlanner",
                "WarehouseOperator"
              ]
            }
          }
        }
      }
    }
  }
}
