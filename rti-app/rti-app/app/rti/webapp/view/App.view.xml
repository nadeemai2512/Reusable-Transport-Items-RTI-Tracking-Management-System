<mvc:View controllerName="rti.app.controller.App" displayBlock="true" height="100%"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt">
  <tnt:ToolPage id="toolPage" sideExpanded="true">
    <tnt:header>
      <tnt:ToolHeader>
        <Button icon="sap-icon://menu2" type="Transparent" press=".onToggleSide" tooltip="Toggle navigation"/>
        <Title text="RTI Tracking &amp; Management" level="H2"/>
        <ToolbarSpacer/>
        <ObjectStatus icon="sap-icon://employee" text="{me>/id}" inverted="true"/>
        <Button icon="sap-icon://refresh" type="Transparent" press=".onRefreshAll" tooltip="Reload data from backend"/>
      </tnt:ToolHeader>
    </tnt:header>
    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" itemSelect=".onNavSelect">
        <tnt:NavigationList>
          <tnt:NavigationListItem text="Control Tower" icon="sap-icon://home" key="dashboard"/>
          <tnt:NavigationListItem text="Dispatches" icon="sap-icon://shipping-status" key="dispatches"/>
          <tnt:NavigationListItem text="Returns" icon="sap-icon://undo" key="returns"/>
          <tnt:NavigationListItem text="Inventory" icon="sap-icon://product" key="inventory"/>
          <tnt:NavigationListItem text="Penalties" icon="sap-icon://money-bills" key="penalties" visible="{me>/can/penalties}"/>
          <tnt:NavigationListItem text="Waiver Approvals" icon="sap-icon://approvals" key="waivers" visible="{me>/can/penalties}"/>
          <tnt:NavigationListItem text="Master Data" icon="sap-icon://master-task-triangle" key="masterdata"/>
          <tnt:NavigationListItem text="Ledger &amp; Audit" icon="sap-icon://history" key="ledger"/>
        </tnt:NavigationList>
      </tnt:SideNavigation>
    </tnt:sideContent>
    <tnt:mainContents>
      <NavContainer id="pageContainer"/>
    </tnt:mainContents>
  </tnt:ToolPage>
</mvc:View>
