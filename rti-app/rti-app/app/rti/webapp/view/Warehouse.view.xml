<mvc:View controllerName="rti.app.controller.Warehouse" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
  <Page id="page" title="Warehouse Management" showNavButton="true" navButtonPress=".onNavBack">
    <content>
      <IconTabBar id="tabs" expandable="false" applyContentPadding="false" select=".onTabSelect">
        <items>
          <IconTabFilter key="occupancy" text="Stock by warehouse" icon="sap-icon://building">
            <Table id="occTable" growing="true" growingThreshold="30" noDataText="No warehouse stock"
              items="{path:'/WarehouseOccupancy', parameters:{$orderby:'warehouseCode,assetTypeCode'}}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="Net available = Total owned - (At customer + Damaged + Scrapped)" level="H3"/>
                  <ToolbarSpacer/>
                  <SearchField id="occSearch" width="16rem" placeholder="Warehouse / asset type" search=".onOccSearch" liveChange=".onOccSearch"/>
                  <Button icon="sap-icon://refresh" press=".onRefresh"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="Warehouse"/></Column><Column minScreenWidth="Tablet" demandPopin="true"><Text text="Plant"/></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="Asset type"/></Column>
                <Column hAlign="End"><Text text="Total owned"/></Column><Column hAlign="End"><Text text="At customer"/></Column>
                <Column hAlign="End"><Text text="Damaged"/></Column><Column hAlign="End"><Text text="Scrapped"/></Column>
                <Column hAlign="End"><Text text="Net available"/></Column><Column hAlign="End"><Text text="Safety"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{warehouse/name}" text="{warehouse/code}"/>
                    <Text text="{warehouse/plant}"/>
                    <Text text="{assetType/name}"/>
                    <ObjectNumber number="{totalOwned}"/><ObjectNumber number="{atCustomer}"/>
                    <ObjectNumber number="{damaged}"/><ObjectNumber number="{scrapped}"/>
                    <ObjectNumber number="{netAvailable}" state="{= ${netAvailable} &lt; ${safetyStock} ? 'Error' : 'Success'}"/>
                    <ObjectNumber number="{safetyStock}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <IconTabFilter key="warehouses" text="Warehouses" icon="sap-icon://database">
            <Table id="whTable" noDataText="No warehouses" items="{path:'/Warehouses', parameters:{$$updateGroupId:'rtiGroup', $orderby:'code'}}">
              <headerToolbar><OverflowToolbar><Title text="Warehouses" level="H3"/><ToolbarSpacer/>
                <Button icon="sap-icon://add" text="Add" type="Emphasized" press=".onAddWh" visible="{me>/can/master}"/>
              </OverflowToolbar></headerToolbar>
              <columns><Column><Text text="Code"/></Column><Column><Text text="Name"/></Column><Column><Text text="Plant"/></Column><Column><Text text="City"/></Column><Column width="7rem"><Text text=""/></Column></columns>
              <items><ColumnListItem><cells>
                <ObjectIdentifier title="{code}"/><Text text="{name}"/><Text text="{plant}"/><Text text="{city}"/>
                <HBox visible="{me>/can/master}"><Button icon="sap-icon://edit" type="Transparent" press=".onEditWh"/>
                  <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteWh"/></HBox>
              </cells></ColumnListItem></items>
            </Table>
          </IconTabFilter>

          <IconTabFilter key="carriers" text="Carriers" icon="sap-icon://shipping">
            <Table id="carrTable" noDataText="No carriers" items="{path:'/Carriers', parameters:{$$updateGroupId:'rtiGroup', $orderby:'code'}}">
              <headerToolbar><OverflowToolbar><Title text="Carriers" level="H3"/><ToolbarSpacer/>
                <Button icon="sap-icon://add" text="Add" type="Emphasized" press=".onAddCarr" visible="{me>/can/customers}"/>
              </OverflowToolbar></headerToolbar>
              <columns><Column><Text text="Code"/></Column><Column><Text text="Name"/></Column><Column><Text text="Contact"/></Column><Column><Text text="Active"/></Column><Column width="7rem"><Text text=""/></Column></columns>
              <items><ColumnListItem><cells>
                <ObjectIdentifier title="{code}"/><Text text="{name}"/><Text text="{contact}"/>
                <Text text="{path:'active', formatter:'.formatter.yesNo'}"/>
                <HBox visible="{me>/can/customers}"><Button icon="sap-icon://edit" type="Transparent" press=".onEditCarr"/>
                  <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteCarr"/></HBox>
              </cells></ColumnListItem></items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </content>
  </Page>
</mvc:View>
