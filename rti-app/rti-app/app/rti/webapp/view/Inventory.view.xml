<mvc:View controllerName="rti.app.controller.Inventory" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
  <Page id="page" title="Inventory &amp; Replenishment" showNavButton="true" navButtonPress=".onNavBack">
    <content>
      <IconTabBar id="tabs" expandable="false" applyContentPadding="false" select=".onTabSelect">
        <items>
          <IconTabFilter key="stock" text="Stock by location" icon="sap-icon://product">
            <Table id="stockTable" growing="true" growingThreshold="30" noDataText="No stock records"
              items="{path:'/StockBalances', parameters:{$$updateGroupId:'rtiGroup', $orderby:'createdAt desc'}}">
              <headerToolbar>
                <OverflowToolbar>
                  <Title text="Net available = Total owned - (At customer + Damaged + Scrapped)" level="H3"/>
                  <ToolbarSpacer/>
                  <Button icon="sap-icon://add" text="Add stock record" type="Emphasized" press=".onAddStock" visible="{me>/can/stockEdit}"/>
                  <Button icon="sap-icon://refresh" press=".onRefresh"/>
                </OverflowToolbar>
              </headerToolbar>
              <columns>
                <Column><Text text="Asset type"/></Column><Column><Text text="Warehouse"/></Column>
                <Column hAlign="End"><Text text="Total owned"/></Column><Column hAlign="End"><Text text="At customer"/></Column>
                <Column hAlign="End"><Text text="Damaged / repair"/></Column><Column hAlign="End"><Text text="Scrapped"/></Column>
                <Column hAlign="End"><Text text="Net available"/></Column><Column hAlign="End"><Text text="Safety stock"/></Column>
                <Column width="6rem"><Text text=""/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{assetType/name}" text="{assetType/code}"/>
                    <Text text="{warehouse/name}"/>
                    <ObjectNumber number="{totalOwned}"/><ObjectNumber number="{atCustomer}"/><ObjectNumber number="{damaged}"/><ObjectNumber number="{scrapped}"/>
                    <ObjectNumber number="{netAvailable}" state="{= ${netAvailable} &lt; ${safetyStock} ? 'Error' : 'Success'}"/>
                    <ObjectNumber number="{safetyStock}"/>
                    <Button icon="sap-icon://edit" type="Transparent" press=".onEditStock" visible="{me>/can/stockEdit}" tooltip="Edit stock / safety stock"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <IconTabFilter key="alerts" text="Replenishment alerts" icon="sap-icon://alert" iconColor="Critical" visible="{me>/can/alerts}">
            <Table id="alertTable" noDataText="No location is below its safety stock" items="{path:'/ReplenishmentAlerts', suspended:true}">
              <columns>
                <Column><Text text="Asset type"/></Column><Column><Text text="Warehouse"/></Column>
                <Column hAlign="End"><Text text="Net available"/></Column><Column hAlign="End"><Text text="Safety stock"/></Column>
                <Column hAlign="End"><Text text="Shortfall"/></Column><Column width="10rem"><Text text=""/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{assetType/name}"/><Text text="{warehouse/name}"/>
                    <ObjectNumber number="{netAvailable}" state="Error"/><ObjectNumber number="{safetyStock}"/><ObjectNumber number="{shortfall}" state="Error"/>
                    <Button text="Create requisition" icon="sap-icon://cart" press=".onRequisition" visible="{me>/can/plan}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>

          <IconTabFilter key="requests" text="Replenishment requests" icon="sap-icon://cart" visible="{me>/can/alerts}">
            <Table id="requestTable" noDataText="No replenishment requests" items="{path:'/ReplenishmentRequests', suspended:true, parameters:{$orderby:'createdAt desc'}}">
              <headerToolbar><OverflowToolbar><Title text="Internal requests (not posted to S/4HANA - integration not configured)" level="H3"/></OverflowToolbar></headerToolbar>
              <columns>
                <Column><Text text="Request"/></Column><Column><Text text="Asset type"/></Column><Column><Text text="Warehouse"/></Column>
                <Column hAlign="End"><Text text="Quantity"/></Column><Column><Text text="Status"/></Column><Column><Text text="Remarks"/></Column><Column width="9rem"><Text text=""/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{requestNo}"/><Text text="{assetType/name}"/><Text text="{warehouse/name}"/><ObjectNumber number="{quantity}"/>
                    <ObjectStatus text="{path:'status', formatter:'.formatter.label'}" state="{path:'status', formatter:'.formatter.state'}"/>
                    <Text text="{remarks}"/>
                    <Button text="Mark received" icon="sap-icon://accept" press=".onReceive" visible="{= ${status} !== 'RECEIVED' &amp;&amp; ${me>/can/plan}}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </IconTabFilter>
        </items>
      </IconTabBar>
    </content>
  </Page>
</mvc:View>
